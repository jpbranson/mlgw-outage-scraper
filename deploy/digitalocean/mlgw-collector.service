[Unit]
Description=MLGW five-minute production collection
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/mlgw/collection-enabled

[Service]
Type=simple
User=mlgw
Group=mlgw
WorkingDirectory=/opt/mlgw/current
Environment=NODE_ENV=production
Environment=MLGW_DEPLOYMENT=production
ExecStart=/opt/node/bin/node scripts/production-collector.mjs
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mlgw/data/collector
MemoryMax=384M

[Install]
WantedBy=multi-user.target
